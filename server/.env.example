PORT=5000
NODE_ENV=development
# Neon PostgreSQL pooled connection string (for web application queries)
DATABASE_URL=postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Neon PostgreSQL direct connection string (for DDL schema migrations)
DATABASE_URL_UNPOOLED=postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace_this_with_a_secure_random_string_for_jwt_signing
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
